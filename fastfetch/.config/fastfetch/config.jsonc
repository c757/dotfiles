{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "~/Pictures/fastfetch-card.png",
        "width": 22,
        "height": 13,
        "preserveAspectRatio": true,
        "padding": {
            "right": 2,
            "top": 0
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "title": "38;2;189;147;249",
            "keys": "38;2;255;121;198",
            "output": "38;2;248;248;242",
            "separator": "38;2;98;114;164"
        }
    },

    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "host",
            "key": "󰇄 Host"
        },
        {
            "type": "uptime",
            "key": "󰔛 Uptime"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        {
            "type": "cpu",
            "key": " CPU"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery"
        },
        "colors"
    ]
}